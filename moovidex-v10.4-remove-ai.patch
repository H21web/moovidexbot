-log = logging.getLogger(__name__)
-
-GROQ_URL = "https://api.groq.com/openai/v1/chat/completions"
-TIMEOUT = 15.0
-CACHE_TTL = timedelta(days=30)
-MEMORY_KEEP = 20
-MEMORY_TTL = timedelta(days=7)
-
-_client: httpx.AsyncClient | None = None
