# --- Telegram ---
BOT_TOKEN=
TG_API_ID=
TG_API_HASH=
# NOTE: no user session needed — the bot reads channel history itself
# via MTProto. The bot MUST be admin in every channel you /index.

# --- Database ---
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Access ---
ADMIN_IDS=123456789
FORCE_SUB_CHANNELS=@mychannel1,@mychannel2

# --- Web player ---
WEB_URL=https://your-app.onrender.com
WEB_SECRET=change-this-to-something-random
PORT=8000

# --- Admin dashboard (/admin) ---
ADMIN_PASSWORD=choose-a-strong-password

# --- Optional ---
TMDB_API_KEY=
REQUEST_CHANNEL=@movierequests
LOG_CHANNEL=

# --- Behaviour ---
RESULTS_PER_PAGE=8
PROTECT_CONTENT=false
AUTO_DELETE_SECONDS=0
INDEX_BATCH_SIZE=500

# --- AI (Groq, free tier) — v6 super update. Empty = AI features off. ---
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_DAILY_QUOTA=20
WEBSEARCH_API_URL=https://moovidex.alwaysdata.net
