+def _parse_dl_arg(text: str | None) -> int | None:
+    parts = (text or "").split(maxsplit=1)
+    if len(parts) > 1 and parts[1].startswith("dl_"):
+        try:
+            return int(parts[1][3:])
+        except ValueError:
+            return None
+    return None
+
